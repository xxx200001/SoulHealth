# 复制为 .env 后按需修改。所有配置只在这一处，代码里没有第二份硬编码。

# ---------- 服务端口 ----------
# 前端 vite 也读这个值来配代理，改一处即可
SOULHEALTH_PORT=8001
SOULHEALTH_HOST=0.0.0.0

# ---------- 登录令牌 ----------
# 对外部署务必改成随机长字符串，否则任何人都能伪造登录令牌
SOULHEALTH_SECRET_KEY=
SOULHEALTH_TOKEN_TTL_HOURS=12
# 首次启动会自动创建 admin 账号并在控制台打印随机密码；也可在这里预设
SOULHEALTH_ADMIN_USER=admin
SOULHEALTH_ADMIN_PASSWORD=

# ---------- 大模型（化验单识别 / AI 解读 / 健康问答）----------
# 不填则这三项功能明确报「未配置」，不会返回编造内容；
# 辨证、组方、毒理、风险识别全部离线运行，不受影响
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
SOULHEALTH_LLM_MODEL=claude-sonnet-4-6

# 演示模式：用离线样例数据跑通全流程（仅用于演示，不要用于真实分析）
SOULHEALTH_MOCK=

# ---------- 生物计算 ----------
# real（默认）走公开接口；mock 用本地缓存样例；off 关闭
SOULHEALTH_BIOCOMPUTE=real
# EVO2 变异打分：自建服务或 NVIDIA NIM，未配置时如实标记 skipped
SOULHEALTH_EVO2_URL=http://localhost:8899/v1/evo2/score
NVIDIA_API_KEY=

# ---------- 中医知识库 ----------
# 默认 data/tcm_kb.sqlite（完整库随仓库分发，约 20MB）
SOULHEALTH_TCM_KB=
# 库缺失时是否用内置种子自举一个最小可用库（0 = 关闭）
SOULHEALTH_TCM_KB_AUTOBUILD=1

# ---------- 报告 ----------
# 报告叙述段是否过一遍 LLM 润色。默认关闭：报告由结构化数据 + 模板确定性生成，
# 可复现性优先于文采。开启后只润色纯叙述段（标题/表格/合规声明原样保留），
# 结果仍过合规闸，违规或调用异常自动回退模板原文。需要 ANTHROPIC_API_KEY。
SOULHEALTH_POLISH=

# 报告默认只用化名；置 1 才在报告里打印真实姓名
SOULHEALTH_REPORT_REAL_NAME=
